msgstr ""

#: includes/class-recommender.php:173
msgid "AVIF generato ma non consegnato: il server lo restituisce con il tipo MIME sbagliato e il .htaccess non e' scrivibile. Consegnare una sorgente che il browser sceglie e poi non sa decodificare e' peggio che non consegnarla. Aggiungi \"AddType image/avif .avif\" alla configurazione del server per abilitarla."
msgstr ""

